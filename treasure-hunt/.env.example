# ──────────────────────────────────────────────────────────────
# Treasure Hunt ❤️ — Environment Variables
# Copy this file to .env.local and fill in your Supabase values.
# Find them in: Supabase Dashboard → Project Settings → API
# ──────────────────────────────────────────────────────────────

# Your Supabase project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The anon/publishable key (safe to expose to the browser —
# Row Level Security protects all data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the site URL used in emails/redirects when deployed
NEXT_PUBLIC_SITE_URL=http://localhost:3000
