# ──────────────────────────────────────────────────────────────
# The Treasure Hunt ❤️ — environment variables
# Copy this file to .env.local and fill in your values.
# ──────────────────────────────────────────────────────────────

# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — ONLY used by `npm run seed` (never shipped to the browser).
# From Settings → API → service_role. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Seed script configuration ────────────────────────────────
# The two accounts the seed script creates.
SEED_ADMIN_EMAIL=admin@treasurehunt.love
SEED_ADMIN_PASSWORD=change-me-admin-123
SEED_ADMIN_NAME=Jimil

SEED_PLAYER_EMAIL=player@treasurehunt.love
SEED_PLAYER_PASSWORD=change-me-player-123
SEED_PLAYER_NAME=My Love

# First day of the hunt (YYYY-MM-DD, interpreted in SEED_UTC_OFFSET).
# Riddles unlock each day at 10:00, 14:00 and 21:00.
SEED_GAME_START_DATE=2026-07-20

# UTC offset of the timezone you will play in, e.g. +05:30 for India, -04:00 for New York.
SEED_UTC_OFFSET=+05:30
